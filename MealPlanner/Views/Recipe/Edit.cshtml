@{
    ViewData["Title"] = "Редактирование рецепта";
}

@model MealPlanner.ViewModels.Recipe.RecipeEditViewModel

<div class="mx-auto max-w-3xl">
    
    <div class="mb-6">
        <h1 class="font-bold text-[clamp(22px,2vw,32px)] text-slate-900">Редактировать рецепт</h1>
        <p class="mt-1 text-sm text-slate-600">Измените информацию о блюде и его ингредиентах</p>
    </div>

    <div class="overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm">
        <form asp-controller="Recipe" asp-action="Edit" method="post" enctype="multipart/form-data" class="space-y-6 p-6" id="recipeEditForm">
            
            <div asp-validation-summary="ModelOnly" class="rounded-xl bg-red-50 p-3 text-sm text-red-500"></div>
           
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CurrentImagePath" />
            
            <div class="space-y-6">
                <div class="space-y-2">
                    <label asp-for="Name" class="text-sm font-medium text-slate-700">
                        Название блюда <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="Name" required
                           class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-slate-900 placeholder-slate-400 transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 focus:outline-none" 
                           placeholder="Например: Утка по-пекински" />
                    <span asp-validation-for="Name" class="text-sm text-red-500"></span>
                </div>

                <div class="space-y-2">
                    <label asp-for="Description" class="text-sm font-medium text-slate-700">Описание</label>
                    <textarea asp-for="Description" rows="4"
                              class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-slate-900 placeholder-slate-400 transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 focus:outline-none" 
                              placeholder="Краткое описание блюда"></textarea>
                    <span asp-validation-for="Description" class="text-sm text-red-500"></span>
                </div>

                <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                    <div class="space-y-2">
                        <label asp-for="CookingTime" class="text-sm font-medium text-slate-700">
                            Время (мин) <span class="text-red-500">*</span>
                        </label>
                        <input asp-for="CookingTime" type="number" required min="1" max="1440"
                               class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-slate-900 placeholder-slate-400 transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 focus:outline-none" 
                               placeholder="30" />
                        <span asp-validation-for="CookingTime" class="text-sm text-red-500"></span>
                    </div>

                    <div class="space-y-2">
                        <label class="text-sm font-medium text-slate-700">Изображение блюда</label>
                        <div class="flex items-center gap-3">
                            <label class="flex cursor-pointer items-center gap-2 rounded-xl border-2 border-dashed border-slate-300 px-4 py-2.5 transition hover:border-emerald-500 hover:bg-emerald-50" id="fileSelectButton">
                                <svg class="size-5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" 
                                          d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
                                </svg>
                                <span class="text-sm font-medium text-slate-600">Выбрать файл</span>
                                <input asp-for="ImageFile" type="file" accept="image/*" class="hidden" id="imageFileInput" />
                            </label>
                            
                            <div id="fileInfo" class="hidden items-center gap-2 rounded-lg bg-slate-100 px-3 py-1.5">
                                <span id="fileName" class="max-w-[200px] truncate text-sm text-slate-600"></span>
                                <button type="button" id="clearFileButton" class="flex h-5 w-5 items-center justify-center rounded-full text-slate-400 transition hover:bg-red-100 hover:text-red-600">×</button>
                            </div>
                            <span id="imageFile-error" class="mt-1 block text-sm text-red-500"></span>
                        </div>
                        
                        <div id="imagePreview" class="mt-3 @(string.IsNullOrEmpty(Model.CurrentImagePath) ? "hidden" : "")">
                            <div class="relative inline-block">
                                <img src="@(string.IsNullOrEmpty(Model.CurrentImagePath) ? "" : Model.CurrentImagePath)" 
                                     alt="Превью" 
                                     id="previewImage" 
                                     class="h-32 w-auto rounded-lg object-cover" />
                                <button type="button" id="clearPreviewButton" class="absolute -top-2 -right-2 flex h-6 w-6 items-center justify-center rounded-full bg-red-500 text-white shadow-md transition hover:bg-red-600 hover:shadow-lg">×</button>
                            </div>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(Model.CurrentImagePath))
                        {
                            <p class="mt-2 text-xs text-slate-500">
                                Текущее изображение. Загрузите новое, чтобы заменить.
                            </p>
                        }
                        
                        <span asp-validation-for="ImageFile" class="text-sm text-red-500"></span>
                    </div>
                </div>
            </div>

            <hr class="border-slate-200" />

            <div class="space-y-4">
                <div>
                    <h2 class="text-lg font-semibold text-slate-900">
                        Ингредиенты <span class="text-red-500">*</span>
                    </h2>
                    <p class="text-sm text-slate-600">Добавьте хотя бы один ингредиент для приготовления</p>
                </div>
                
                <div id="ingredients-error" class="hidden rounded-xl bg-red-50 p-3 text-sm text-red-500">
                    Добавьте хотя бы один ингредиент
                </div>

                <div id="ingredients-container" class="flex flex-col gap-3">
                    @for (int i = 0; i < Model.RecipeIngredients.Count; i++)
                    {
                        <div class="ingredient-row">
                            <div class="grid grid-cols-1 items-start gap-3 md:grid-cols-3">
                                <div class="space-y-1">
                                    <select asp-for="RecipeIngredients[i].IngredientId" 
                                            asp-items="Model.PossibleRecipeIngredients"
                                            required>
                                        <option value="">Выберите ингредиент</option>
                                    </select>
                                    <span asp-validation-for="RecipeIngredients[i].IngredientId" class="text-sm text-red-500"></span>
                                </div>
        
                                <div class="space-y-1">
                                    <input asp-for="RecipeIngredients[i].Amount" 
                                           type="number" 
                                           min="1" 
                                           max="10000"
                                           required
                                           class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-900 placeholder-slate-400 transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 focus:outline-none" />
                                    <span asp-validation-for="RecipeIngredients[i].Amount" class="text-sm text-red-500"></span>
                                </div>
        
                                <button type="button" class="delete-btn rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm font-medium text-red-600 transition hover:bg-red-100">
                                    Удалить
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <button type="button" id="addIngredientBtn"
                        class="w-fit rounded-xl border-2 border-dashed border-slate-300 px-4 py-2 text-sm font-medium text-slate-600 transition hover:border-emerald-500 hover:text-emerald-600">
                    + Добавить ингредиент
                </button>
            </div>

            <div class="space-y-2">
                <label asp-for="Instructions" class="text-sm font-medium text-slate-700">Инструкции</label>
                <textarea asp-for="Instructions" rows="8"
                          class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-slate-900 placeholder-slate-400 transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 focus:outline-none" 
                          placeholder="Пошаговая инструкция..."></textarea>
                <span asp-validation-for="Instructions" class="text-sm text-red-500"></span>
            </div>

            <hr class="border-slate-200" />

            <div class="flex justify-end gap-3">
                <a asp-controller="Recipe" asp-action="Details" asp-route-id="@Model.Id" class="rounded-xl px-5 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-100">
                    Отмена
                </a>
                <button type="submit" class="rounded-xl bg-emerald-500 px-5 py-2.5 text-sm font-medium text-white transition hover:-translate-y-0.5 hover:bg-emerald-600 hover:shadow-lg">
                    Сохранить изменения
                </button>
            </div>
        </form>
    </div>
</div>

<script src="~/js/recipe-form.js"></script>