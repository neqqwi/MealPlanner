@{
    ViewData["Title"] = "Список рецептов";
}
@model IEnumerable<RecipeViewModel>

<div class="flex flex-col gap-6">

    <div class="flex flex-wrap items-center justify-between gap-4">

        <h1 class="font-bold text-[clamp(22px,2vw,32px)] text-slate-900">
            Рецепты
        </h1>

        <a href="#"
           class="rounded-full bg-emerald-500 px-5 py-2 font-medium text-white
            transition hover:-translate-y-0.5 hover:bg-emerald-600 hover:shadow-lg">
            + Создать рецепт
        </a>

    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">

        @foreach (var recipe in Model)
        {
            <div class="flex flex-col overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm
                transition hover:-translate-y-1 hover:shadow-lg">

                <div class="h-48 w-full overflow-hidden">
                    <img src="@recipe.ImageUrl"
                         class="h-full w-full object-cover object-center"
                         alt="@recipe.Name" />
                </div>

                <div class="flex flex-1 flex-col gap-3 p-4">

                    <h2 class="text-lg font-semibold text-slate-900">
                        @recipe.Name
                    </h2>

                    <div class="flex items-center gap-2 text-sm text-slate-600">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                        </svg>
                        <span>@recipe.CookingTime мин</span>
                    </div>

                    <p class="line-clamp-3 text-sm leading-snug text-slate-500">
                        @recipe.Description
                    </p>

                    <div class="mt-auto pt-3">
                        <button type="button" class="flex w-full items-center justify-center gap-2 rounded-xl
                            bg-slate-900 px-4 py-2 text-sm font-medium text-white
                            transition hover:bg-slate-800">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9-6h.008v.008H12v-.008ZM12 15h.008v.008H12V15Zm0 2.25h.008v.008H12v-.008ZM9.75 15h.008v.008H9.75V15Zm0 2.25h.008v.008H9.75v-.008ZM7.5 15h.008v.008H7.5V15Zm0 2.25h.008v.008H7.5v-.008Zm6.75-4.5h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V15Zm0 2.25h.008v.008h-.008v-.008Zm2.25-4.5h.008v.008H16.5v-.008Zm0 2.25h.008v.008H16.5V15Z" />
                            </svg>
                            Добавить в план
                        </button>
                    </div>

                </div>
            </div>
        }

    </div>

</div>