@{
    ViewData["Title"] = "Список рецептов";
}
@model MealPlanner.ViewModels.Shared.PaginatedListViewModel<Recipe>

<div class="mx-auto max-w-7xl">

    <div class="flex flex-col gap-6">

        <div class="flex flex-wrap items-center justify-between gap-4">
            <h1 class="font-bold text-[clamp(22px,2vw,32px)] text-slate-900">
                Рецепты
            </h1>

            <a asp-action="Create"
               asp-controller="Recipe"
               class="rounded-full bg-emerald-500 px-5 py-2 font-medium text-white
                      transition hover:-translate-y-0.5 hover:bg-emerald-600 hover:shadow-lg">
                + Создать рецепт
            </a>
        </div>

        <form asp-action="Index" method="get" class="relative">
            <input type="text"
                   name="searchTerm"
                   value="@Model.SearchTerm"
                   placeholder="Поиск рецепта по названию..."
                   class="w-full rounded-xl border border-slate-200 px-4 py-3 pl-11 text-slate-900 placeholder-slate-400
                          transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 focus:outline-none" />
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" 
                 class="absolute top-1/2 left-4 size-5 -translate-y-1/2 text-slate-400">
                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
            </svg>
        </form>

        @if (!Model.Items.Any())
        {
            <div class="flex flex-col items-center justify-center rounded-2xl border border-slate-100 bg-white py-16 text-slate-500 shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="mb-4 size-16 text-slate-300">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
                </svg>
                
                @if (string.IsNullOrEmpty(ViewData["SearchTerm"]?.ToString()))
                {
                    <p class="mt-1 text-sm text-slate-500">Список рецептов пуст</p>
                }
                else
                {
                    <p class="mt-1 text-sm text-slate-500">Ничего не найдено по вашему запросу</p>
                }
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                @foreach (var recipe in Model.Items)
                {
                    <div class="flex flex-col overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm
                        transition hover:-translate-y-1 hover:shadow-lg">

                        <div class="h-48 w-full overflow-hidden bg-slate-100">
                            <img src="@recipe.ImagePath"
                                 class="h-full w-full object-cover object-center transition duration-300 hover:scale-105"
                                 alt="@recipe.Name" 
                                 onerror="this.onerror=null; this.src='/images/no-image.svg';"/>
                        </div>

                        <div class="flex flex-1 flex-col gap-3 p-4">
                            <h2 class="line-clamp-1 text-lg font-semibold text-slate-900" title="@recipe.Name">
                                @recipe.Name
                            </h2>

                            <div class="flex items-center gap-2 text-sm text-slate-600">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5 text-emerald-500">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                </svg>
                                <span>@recipe.CookingTime мин</span>
                            </div>

                            <p class="line-clamp-3 text-sm leading-snug text-slate-500">
                                @recipe.Description
                            </p>

                            <div class="mt-auto flex flex-col gap-2 pt-3">

                                @* <button type="button" class="flex w-full items-center justify-center gap-2 rounded-xl bg-emerald-500 px-4 py-2 text-sm font-medium text-white
                                        transition hover:-translate-y-0.5 hover:bg-emerald-600 hover:shadow-lg">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9-6h.008v.008H12v-.008ZM12 15h.008v.008H12V15Zm0 2.25h.008v.008H12v-.008ZM9.75 15h.008v.008H9.75V15Zm0 2.25h.008v.008H9.75v-.008ZM7.5 15h.008v.008H7.5V15Zm0 2.25h.008v.008H7.5v-.008Zm6.75-4.5h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V15Zm0 2.25h.008v.008h-.008v-.008Zm2.25-4.5h.008v.008H16.5v-.008Zm0 2.25h.008v.008H16.5V15Z" />
                                        </svg>
                                        Добавить в план
                                    </button> *@

                                <a asp-action="Details" 
                                   asp-route-id="@recipe.Id" 
                                   class="flex w-full items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700
                                          transition hover:-translate-y-0.5 hover:border-emerald-200 hover:bg-slate-50 hover:text-emerald-600 hover:shadow-lg">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                    </svg>
                                    Подробнее
                                </a>

                            </div>
                        </div>
                    </div>
                }
            </div>
        }

            @if (Model.TotalPages > 1)
            {
                <div class="mt-8 flex items-center justify-center gap-4">
                    @if (Model.CurrentPage > 1)
                    {
                        <a asp-action="Index" 
                           asp-route-page="@(Model.CurrentPage - 1)" 
                           asp-route-pageSize="8"
                           asp-route-searchTerm="@Model.SearchTerm"
                           class="flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 hover:text-emerald-600 hover:shadow-md">
                            ← Назад
                        </a>
                    }
                    else
                    {
                        <span class="flex cursor-not-allowed items-center gap-2 rounded-xl border border-slate-100 bg-slate-50 px-4 py-2 text-sm font-medium text-slate-400">
                            ← Назад
                        </span>
                    }

                    <span class="px-2 text-sm font-medium text-slate-600">
                        Страница @Model.CurrentPage из @Model.TotalPages
                    </span>

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a asp-action="Index" 
                           asp-route-page="@(Model.CurrentPage + 1)" 
                           asp-route-pageSize="8"
                           asp-route-searchTerm="@Model.SearchTerm"
                           class="flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 hover:text-emerald-600 hover:shadow-md">
                            Вперед →
                        </a>
                    }
                    else
                    {
                        <span class="flex cursor-not-allowed items-center gap-2 rounded-xl border border-slate-100 bg-slate-50 px-4 py-2 text-sm font-medium text-slate-400">
                            Вперед →
                        </span>
                    }
                </div>
            }

    </div>
</div>