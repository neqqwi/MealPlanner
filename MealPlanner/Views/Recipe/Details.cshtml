@{
    ViewData["Title"] = Model.Name;
}

@model MealPlanner.Models.Recipe

<div class="mx-auto max-w-5xl">
    <div class="mb-6">
        <a asp-action="Index" class="inline-flex items-center gap-2 text-sm font-medium text-slate-600 transition hover:text-emerald-600">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
            </svg>
            К списку рецептов
        </a>
    </div>

    <div class="overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm">
        
        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <div class="h-80 w-full overflow-hidden sm:h-96">
                <img src="@Model.ImagePath" alt="@Model.Name" class="h-full w-full object-cover object-center" />
            </div>
        }

        <div class="p-6 sm:p-8">
            <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex-1">
                    <h1 class="text-2xl font-bold text-slate-900 sm:text-3xl">@Model.Name</h1>
                </div>
                
                <div class="flex items-center gap-2 rounded-full bg-emerald-50 px-4 py-1.5 whitespace-nowrap text-emerald-700">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                    <span class="font-semibold">@Model.CookingTime мин</span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="mb-6 text-base leading-relaxed text-slate-600">@Model.Description</p>
                <hr class="border-slate-200" />
            }

            <div class="mt-8 grid gap-8 lg:grid-cols-3">
                
                <div class="lg:col-span-1">
                    <h2 class="mb-4 flex items-center gap-2 text-lg font-semibold text-slate-900">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-emerald-600">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                        </svg>
                        Ингредиенты
                    </h2>
                    
                    @if (Model.RecipeIngredients != null && Model.RecipeIngredients.Any())
                    {
                        <ul class="space-y-3">
                            @foreach (var ri in Model.RecipeIngredients)
                            {
                                <li class="flex items-center justify-between rounded-xl border border-slate-100 bg-slate-50 px-4 py-3">
                                    <span class="font-medium text-slate-800">@ri.Ingredient.Name</span>
                                    <span class="text-sm font-semibold text-slate-600">
                                        @ri.Amount @ri.Ingredient.Unit
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-sm text-slate-500 italic">Ингредиенты не указаны</p>
                    }
                </div>

                <div class="lg:col-span-2">
                    <h2 class="mb-4 flex items-center gap-2 text-lg font-semibold text-slate-900">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-emerald-600">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                        </svg>
                        Приготовление
                    </h2>
                    
                    @if (!string.IsNullOrEmpty(Model.Instructions))
                    {
                        <div class="prose prose-slate max-w-none rounded-xl border border-slate-100 bg-slate-50 p-6 text-left leading-relaxed text-slate-700" 
                         style="white-space: pre-line;"> @Model.Instructions </div>
                    }
                    else
                    {
                        <p class="text-sm text-slate-500 italic">Пошаговая инструкция не указана</p>
                    }
                </div>

            </div>

            <div class="mt-8 flex flex-wrap gap-3 border-t border-slate-200 pt-6">
                 @*
                <button type="button" class="inline-flex items-center gap-2 rounded-xl bg-emerald-500 px-6 py-2.5 text-sm font-medium text-white transition hover:-translate-y-0.5 hover:bg-emerald-600 hover:shadow-lg">
                    Добавить в план
                </button>*@


                <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-6 py-2.5 text-sm font-medium text-slate-700 transition hover:-translate-y-0.5 hover:border-emerald-200 hover:bg-slate-50 hover:text-emerald-600 hover:shadow-lg">
                    Редактировать
                </a>

               @* <form asp-controller="Recipe" asp-action="Delete" asp-route-id="@Model.Id" method="post" class="inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-red-500 px-6 py-2.5 text-sm font-medium text-white transition hover:-translate-y-0.5 hover:bg-red-600 hover:shadow-lg">
                        Удалить
                    </button>
                </form>
                 *@
            </div>

        </div>
    </div>
</div>