@{
    ViewData["Title"] = "Удаление ингредиента";
}

@model MealPlanner.ViewModels.Ingredient.IngredientDeleteViewModel

<div class="mx-auto max-w-3xl">
    
    <div class="mb-6">
        <h1 class="font-bold text-[clamp(22px,2vw,32px)] text-slate-900">Удаление ингредиента</h1>
        <p class="mt-1 text-sm text-slate-600">Это действие нельзя будет отменить</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-4 rounded-xl border border-red-200 bg-red-50 p-4">
            <p class="text-sm text-red-800">@TempData["ErrorMessage"]</p>
        </div>
    }

    <div class="overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm">
        <form asp-action="Delete" method="post" class="space-y-6 p-6">

            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            
            <div class="space-y-4">
                @if (Model.RecipesCount > 0)
                {
                    <div class="rounded-xl border border-red-200 bg-red-50 p-4">
                        <div class="flex items-start gap-3">
                            <svg class="mt-0.5 size-5 flex-shrink-0 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                            <div class="flex-1">
                                <p class="text-sm font-medium text-red-900">Нельзя удалить ингредиент</p>
                                <p class="mt-1 text-sm text-red-800">
                                    Ингредиент <strong class="font-semibold">"@Model.Name (@Model.Unit)"</strong> используется в 
                                    <strong>@Model.RecipesCount</strong> @(Model.RecipesCount == 1 ? "рецепте" : "рецептах").
                                </p>
                                @if (Model.ExampleRecipes.Any())
                                {
                                    <p class="mt-2 text-sm text-red-700">Примеры:</p>
                                    <ul class="mt-1 list-inside list-disc text-sm text-red-700">
                                        @foreach (var recipe in Model.ExampleRecipes)
                                        {
                                            <li>
                                                <a asp-action="Details" asp-controller="Recipe" asp-route-id="@recipe.RecipeId" class="font-medium underline hover:text-red-900">@recipe.RecipeName</a>
                                            </li>
                                        }
                                    </ul>
                                }
                                <p class="mt-2 text-xs text-red-600">
                                    Сначала удалите ингредиент из этих рецептов.
                                </p>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="rounded-xl border border-amber-200 bg-amber-50 p-4">
                        <div class="flex items-start gap-3">
                            <svg class="mt-0.5 size-5 flex-shrink-0 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                            <div class="flex-1">
                                <p class="text-sm font-medium text-amber-900">Внимание!</p>
                                <p class="mt-1 text-sm text-amber-800">
                                    Вы собираетесь удалить ингредиент <strong class="font-semibold">"@Model.Name (@Model.Unit)"</strong>.
                                    Это действие удалит его из базы данных навсегда.
                                </p>
                            </div>
                        </div>
                    </div>
                }

                <div class="space-y-3">
                    <div>
                        <label class="text-sm font-medium text-slate-700">Название ингредиента</label>
                        <div class="mt-1 rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-slate-900">
                            @Model.Name
                        </div>
                    </div>

                    <div>
                        <label class="text-sm font-medium text-slate-700">Единица измерения</label>
                        <div class="mt-1 rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-slate-900">
                            @Model.Unit
                        </div>
                    </div>
                </div>
            </div>

            <hr class="border-slate-200" />

            <div class="flex justify-end gap-3">
                <a asp-action="Index" class="rounded-xl px-5 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-100">
                    Отмена
                </a>
                @if (Model.RecipesCount == 0)
                {
                    <button type="submit" class="rounded-xl bg-red-500 px-5 py-2.5 text-sm font-medium text-white transition hover:-translate-y-0.5 hover:bg-red-600 hover:shadow-lg">
                        Удалить ингредиент
                    </button>
                }
            </div>
        </form>
    </div>
</div>