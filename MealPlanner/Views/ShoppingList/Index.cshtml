@{
    ViewData["Title"] = "Список покупок";
}
@model List<MealPlanner.ViewModels.ShoppingList.ShoppingListItemViewModel>

<div class="mx-auto max-w-3xl">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <div>
            <h1 class="font-bold text-[clamp(22px,2vw,32px)] text-slate-900">
                Список покупок
            </h1>
            <p class="mt-1 text-sm text-slate-500">
                Рассчитан от <span class="font-semibold text-emerald-600">@ViewData["CurrentDayName"]</span> до конца недели, с учетом ваших запасов.
            </p>
        </div>
        <a asp-controller="WeeklyPlan" asp-action="Index"
           class="rounded-full border border-slate-200 bg-white px-5 py-2 font-medium text-slate-700 transition hover:-translate-y-0.5 hover:bg-slate-50 hover:shadow-md">
            ← К плану на неделю
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="flex flex-col items-center justify-center rounded-2xl border border-slate-100 bg-white py-16 text-center shadow-sm">
            <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-8 text-emerald-600">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
            </div>
            <h3 class="text-lg font-semibold text-slate-900">Всё есть дома!</h3>
            <p class="mt-1 text-sm text-slate-500">Вам не нужно ничего докупать для запланированных блюд.</p>
        </div>
    }
    else
    {
        <div class="rounded-2xl border border-slate-100 bg-white shadow-sm">
            <div class="grid grid-cols-1 divide-y divide-slate-100">
                @foreach (var item in Model)
                {
                    <div class="flex items-center gap-4 p-4 transition hover:bg-slate-50">
                        <input type="checkbox" class="size-5 cursor-pointer rounded border-slate-300 text-emerald-600 focus:ring-emerald-500" />
                        
                        <div class="flex-1">
                            <p class="font-medium text-slate-900">@item.IngredientName</p>
                        </div>
                        <div class="text-right">
                            <span class="inline-flex items-center rounded-full bg-emerald-50 px-3 py-1 text-sm font-semibold text-emerald-700">
                                @item.AmountNeeded @item.Unit
                            </span>
                        </div>
                    </div>
                }
            </div>
            
            <div class="flex flex-wrap justify-end gap-3 rounded-b-2xl border-t border-slate-100 bg-slate-50 p-4">
                <button onclick="window.print()" class="flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0 1 10.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0 .229 2.523a1.125 1.125 0 0 1-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0 0 21 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 0 0-1.913-.247M6.34 18H5.25A2.25 2.25 0 0 1 3 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 0 1 1.913-.247m10.5 0a48.536 48.536 0 0 0-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18 10.5h.008v.008H18V10.5Zm-3 0h.008v.008H15V10.5Z" />
                    </svg>
                    Распечатать
                </button>
            </div>
        </div>
    }
</div>

<style>
    @@media print {
        body * {
            visibility: hidden;
        }
        .mx-auto.max-w-3xl, .mx-auto.max-w-3xl * {
            visibility: visible;
        }
        .mx-auto.max-w-3xl {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            box-shadow: none;
            border: none;
        }
        /* Скрываем кнопки при печати */
        button, a {
            display: none !important;
        }
        /* Делаем чекбоксы видимыми при печати */
        input[type="checkbox"] {
            visibility: visible !important;
        }
    }
</style>